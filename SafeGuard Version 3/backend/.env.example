PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
DB_PATH=./data/safety.db
# Demo records are disabled by default. Set true only for a disposable demo database.
SEED_DEMO_DATA=false
# Outbound contact delivery is disabled by default. Enable only after adding verified contacts and consent.
# Set to sms,call (or sms / call) only after testing provider configuration.
ALERT_DELIVERY=off
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+12345678900
# Crime-risk model: "mock" (default prototype) or "http" (external model service, e.g. a Python Random Forest)
CRIME_MODEL=mock
CRIME_MODEL_URL=http://localhost:8000/predict
# Transcript classifier can use the local trained model (trained) or a remote adapter; STT is separate.
VOICE_STT=mock
VOICE_STT_URL=http://localhost:8001/transcribe
# Free-tier Groq Whisper STT: set VOICE_STT=groq and add a private GROQ_API_KEY in backend/.env.
# GROQ_STT_MODEL=whisper-large-v3-turbo
VOICE_CLASSIFIER=trained
VOICE_CLASSIFIER_URL=http://localhost:8002/classify
# For Gemini audio transcription + transcript classification, set both stages to gemini and add the server-side key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# For OpenAI pretrained Whisper + moderation, set both voice stages to openai and add your server-side key.
# Keep the key only in backend/.env. Audio/transcripts are sent to OpenAI for analysis.
# OPENAI_API_KEY=
# OPENAI_STT_MODEL=whisper-1
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# Risk fusion weights; values are normalized to sum to 1 at runtime.
RISK_WEIGHT_CRIME=0.25
RISK_WEIGHT_THREAT=0.35
RISK_WEIGHT_FALL=0.30
RISK_WEIGHT_GEOFENCE=0.10
